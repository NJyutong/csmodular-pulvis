+    orchestra() {
+        const lines = [];
+        for (let slot = 1; slot <= 8; slot++) {
+            const entry = this.slots.get(slot);
+            lines.push(entry
+                ? `giGrainSample${slot} ftgen 0, 0, 0, -1, "${entry.path}", 0, 0, 1`
+                : `giGrainSample${slot} ftgen 0, 0, 2, -2, 0`);
+        }
