--- /dev/null
+++ b/src/ui/positionContextMenu.js
@@ -0,0 +1,10 @@
+export function positionContextMenu(menu, x, y) {
+    const inset = 8;
+    menu.style.maxHeight = 'calc(100dvh - 16px)';
+    menu.style.overflowY = 'auto';
+    menu.style.display = 'block';
+    menu.scrollTop = 0;
+    const {width, height} = menu.getBoundingClientRect();
+    menu.style.left = Math.max(inset, Math.min(x, window.innerWidth - width - inset)) + 'px';
+    menu.style.top = Math.max(inset, Math.min(y, window.innerHeight - height - inset)) + 'px';
+}
diff --git a/src/utils/locale.js b/src/utils/locale.js
new file mode 100644
index 0000000..0ab9d23
--- /dev/null
+++ b/src/utils/locale.js
@@ -0,0 +1,49 @@
+// Grain library interface languages follow the preferred browser/system locale.
+const supported = new Set(['zh', 'ru', 'en']);
+
+export function getUiLanguage(languages = undefined) {
+    const preferences = languages ?? (typeof navigator !== 'undefined'
+        ? [...(navigator.languages || []), navigator.language]
+        : []);
+    for (const preference of Array.isArray(preferences) ? preferences : [preferences]) {
+        const code = String(preference || '').toLowerCase().split(/[-_]/, 1)[0];
+        if (supported.has(code)) return code;
+    }
+    return 'en';
+}
+
+export function localize(text, language = getUiLanguage()) {
+    if (!text || typeof text !== 'object' || Array.isArray(text)) return text ?? '';
+    return text[language] ?? text.en ?? text.zh ?? text.ru ?? '';
+}
+
+const preferenceKey = 'pulvis-ui-language';
+let pulvisPreference = 'auto';
+try {
+    const saved = globalThis.window?.localStorage?.getItem(preferenceKey);
+    if (supported.has(saved)) pulvisPreference = saved;
+} catch {}
+
+export const getPulvisPreference = () => pulvisPreference;
+export const getPulvisLanguage = () => pulvisPreference === 'auto' ? getUiLanguage() : pulvisPreference;
+export const localizePulvis = text => localize(text, getPulvisLanguage());
+
+export function setPulvisPreference(value) {
+    if (value !== 'auto' && !supported.has(value)) return;
+    pulvisPreference = value;
+    try {
+        if (value === 'auto') globalThis.window?.localStorage?.removeItem(preferenceKey);
+        else globalThis.window?.localStorage?.setItem(preferenceKey, value);
+    } catch {}
+}
+
+export function localizeDefinition(definition, language) {
+    definition.uiLanguage = language;
+    if (definition.displayNameI18n) definition.displayName = localize(definition.displayNameI18n, language);
+    if (definition.tooltipI18n) definition.tooltip = localize(definition.tooltipI18n, language);
+    for (const item of definition.components || []) {
+        if (item.itemsI18n) item.items = localize(item.itemsI18n, language);
+        if (item.textI18n) item.text = localize(item.textI18n, language);
+        if (item.connectorNameI18n) item.ConnectorName = localize(item.connectorNameI18n, language);
+    }
+}
