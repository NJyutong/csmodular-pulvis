+        const sign = rounded > 0 ? '+' : '';
+        const stText = `${sign}${Number.isInteger(rounded) ? rounded : rounded.toFixed(1)}st`;
+        if (!detailed) return `${sign}${Math.round(v)}st`;
+        if (modName === 'GrainOsc') {
