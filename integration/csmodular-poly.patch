+    const scales = panel.pulvisScaleMode ? KEY_SCALES : REL_INTERVALS;
+    panel.pulvisScale = scales.some(s => s.idx === settings.scale) ? settings.scale : (panel.pulvisScaleMode ? 5 : 0);
+    panel.pulvisKeyRoot = Math.round(bounded(settings.keyRoot, 0, 11));
+    panel.pulvisSync = Math.round(bounded(settings.sync, 0, 8));
+    panel.pulvisTone = bounded(settings.tone, -1, 1);
+    panel.pulvisSlotRoots = {};
