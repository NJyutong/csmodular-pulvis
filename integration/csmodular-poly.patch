+function hitTestOled(panel, x, y) {
+    const relX = x - panel.pixelX, relY = y - panel.pixelY;
+    if (relX < 10 || relX > 490 || relY < 32 || relY > 90) return null;
+    const controls = panel.pulvisControls;
+    if (relX >= 356) return 'window';
+    if (relY < 52) {
