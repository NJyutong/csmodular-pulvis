+    if (panel?.jsonName !== 'GrainSample') return 0;
+    const slot = Math.max(1, Math.min(8, Math.round(readPanelVal(panel, 14, 1))));
+    const rootMidi = Number(panel.pulvisSlotRoots?.[slot]) || 0;
+    if (rootMidi <= 0) return 0;
