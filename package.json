{
  "name": "pulvis",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "generate": "node scripts/build-modules.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "icons:generate": "python scripts/build-icons.py",
    "icons:verify": "node scripts/verify-icons.mjs",
    "build:windows-installer": "node scripts/build-windows-installer.mjs --arch=all",
    "build:windows-x64": "node scripts/build-windows-installer.mjs --arch=x64",
    "build:windows-arm64": "node scripts/build-windows-installer.mjs --arch=arm64",
    "build:macos-arm64": "bash scripts/build-macos-pkg.sh --arch=arm64",
    "build:macos-x64": "bash scripts/build-macos-pkg.sh --arch=x64",
    "build:macos-all": "bash scripts/build-macos-pkg.sh --arch=all",
    "readme:check": "node scripts/check-readmes.mjs",
    "sync": "node scripts/install.mjs",
    "test:unit": "node --test tests/contracts.mjs tests/granular-workflow.mjs",
    "test:dsp": "node tests/dsp.mjs",
    "test:install": "node tests/install.mjs",
    "test:integration": "node tests/integration.mjs",
    "test:system": "node tests/system-smoke.mjs",
    "test:dsp-node": "node --no-warnings tests/dsp-node.mjs",
    "test:build-cleanup": "node tests/build-cleanup.mjs",
    "test:host-workflow": "node tests/host-workflow.mjs",
    "test:performance": "node --no-warnings tests/performance-regression.mjs",
    "test:spectral": "node --no-warnings tests/spectral-regression.mjs",
    "test:osc-carrier": "node --no-warnings tests/osc-carrier.mjs",
    "test:desktop-package": "node scripts/package-smoke.mjs",
    "check:suite": "node scripts/check-suite.mjs",
    "check:quick": "node scripts/check.mjs quick",
    "check:full": "node scripts/check.mjs full",
    "build:linux-deb": "bash scripts/build-linux-deb.sh",
    "release:checksums": "node scripts/write-release-checksums.mjs",
    "package:smoke": "node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "@csound/browser": "7.0.0-beta33",
    "playwright-core": "1.65.0",
    "vite": "7.3.0"
  }
}
