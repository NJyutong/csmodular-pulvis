{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulvis Installer",
  "version": "0.0.6",
  "identifier": "com.csmodular.pulvis.installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pulvis Installer",
        "width": 620,
        "height": 520,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "useLocalToolsDir": true,
    "category": "Utility",
    "shortDescription": "Pulvis granular synthesis library for CsModular",
    "longDescription": "Install or update Pulvis in the CsModular host library folder.",
    "copyright": "Copyright © 2026 Zhang Shengwei",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
